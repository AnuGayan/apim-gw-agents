<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <parent>
        <groupId>org.wso2.gw.ext</groupId>
        <artifactId>azure.gw.client</artifactId> <!-- To be created: azure/pom.xml -->
        <version>1.0.0-SNAPSHOT</version> <!-- Version aligned with typical project structure -->
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <modelVersion>4.0.0</modelVersion>
    <artifactId>azure.gw.manager</artifactId>
    <name>Azure API Management Gateway Agent Component</name>
    <packaging>bundle</packaging>

    <properties>
        <!-- Define Azure SDK versions -->
        <azure.identity.version>1.12.0</azure.identity.version>
        <azure.resourcemanager.apimanagement.version>1.0.0</azure.resourcemanager.apimanagement.version>
        <compiler.source.version>1.8</compiler.source.version>
        <compiler.target.version>1.8</compiler.target.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>${compiler.source.version}</maven.compiler.source>
        <maven.compiler.target>${compiler.target.version}</maven.compiler.target>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.felix</groupId>
                <artifactId>maven-bundle-plugin</artifactId>
                <version>3.2.0</version> <!-- Using version from AWS pom -->
                <extensions>true</extensions>
                <configuration>
                    <instructions>
                        <Bundle-SymbolicName>${project.artifactId}</Bundle-SymbolicName>
                        <Bundle-Name>${project.artifactId}</Bundle-Name>
                        <Import-Package>
                            com.azure.core.credential.*;version="[1.0,2.0)",
                            com.azure.core.management.*;version="[1.0,2.0)",
                            com.azure.core.management.profile.*;version="[1.0,2.0)",
                            com.azure.identity.*;version="[1.12,2.0)",
                            com.azure.resourcemanager.apimanagement.*;version="[1.0,2.0)",
                            com.azure.resourcemanager.apimanagement.models.*;version="[1.0,2.0)",
                            org.wso2.carbon.apimgt.api;version="[6.0.0,7.0.0)",
                            org.wso2.carbon.apimgt.api.model;version="[6.0.0,7.0.0)",
                            org.apache.commons.logging;version="[1.2,2.0)",
                            org.osgi.framework;version="[1.8.0,2.0.0)",
                            org.osgi.service.component;version="[1.4.0,2.0.0)",
                            *;resolution:=optional
                        </Import-Package>
                        <Export-Package>
                            org.wso2.azure.client.*;version="${project.version}"
                        </Export-Package>
                        <DynamicImport-Package>*</DynamicImport-Package>
                        <!-- <Embed-Dependency>
                            azure-identity;scope=compile|runtime,
                            azure-resourcemanager-apimanagement;scope=compile|runtime,
                            *;scope=compile|runtime;inline=true
                        </Embed-Dependency> -->
                        <Embed-Transitive>true</Embed-Transitive>
                    </instructions>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.8.1</version> <!-- Updated version -->
                <configuration>
                    <source>${compiler.source.version}</source>
                    <target>${compiler.target.version}</target>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <dependencies>
        <!-- WSO2 APIM dependencies -->
        <dependency>
            <groupId>org.wso2.carbon.apimgt</groupId>
            <artifactId>org.wso2.carbon.apimgt.impl</artifactId>
            <scope>provided</scope> <!-- Typically provided by the Carbon environment -->
        </dependency>
        <dependency>
            <groupId>org.wso2.carbon.apimgt</groupId>
            <artifactId>org.wso2.carbon.apimgt.api</artifactId>
            <scope>provided</scope> <!-- Typically provided by the Carbon environment -->
        </dependency>

        <!-- Azure SDK dependencies -->
        <dependency>
            <groupId>com.azure</groupId>
            <artifactId>azure-identity</artifactId>
            <version>${azure.identity.version}</version>
        </dependency>
        <dependency>
            <groupId>com.azure.resourcemanager</groupId>
            <artifactId>azure-resourcemanager-apimanagement</artifactId>
            <version>${azure.resourcemanager.apimanagement.version}</version>
        </dependency>

        <!-- Utilities -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
            <version>3.12.0</version> <!-- Ensure this is available or use version from parent -->
        </dependency>
        <dependency>
            <groupId>commons-logging</groupId>
            <artifactId>commons-logging</artifactId>
            <version>1.2</version> <!-- Standard logging API -->
             <scope>provided</scope>
        </dependency>
         <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.8.9</version> <!-- Or version from parent -->
             <scope>provided</scope> <!-- Usually provided -->
        </dependency>
        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
            <version>30.1-jre</version> <!-- Or version from parent -->
            <scope>provided</scope> <!-- Usually provided -->
        </dependency>
        <dependency>
            <groupId>org.osgi</groupId>
            <artifactId>org.osgi.core</artifactId>
            <version>6.0.0</version> <!-- Or a version compatible with WSO2 Carbon -->
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.osgi</groupId>
            <artifactId>org.osgi.service.component.annotations</artifactId>
            <version>1.4.0</version> <!-- Or a version compatible with WSO2 Carbon -->
            <scope>provided</scope>
        </dependency>

    </dependencies>
</project>
